+/// Optional RFC 7540 priority section on an outgoing HEADERS frame.
+/// [weight] is the semantic weight (1..256), not the encoded byte (0..255).
+/// This metadata does not change the local stream scheduler.
+class HeadersPriority {
+  final int streamDependency;
+  final int weight;
+  final bool exclusive;
+
+  const HeadersPriority({required this.streamDependency, required this.weight,
+      this.exclusive = false})
+      : assert(streamDependency >= 0 && streamDependency <= 0x7fffffff),
+        assert(weight >= 1 && weight <= 256);
+}
+
 class HeadersFrame extends Frame {
   static const int FLAG_END_STREAM = 0x1;
   static const int FLAG_END_HEADERS = 0x4;
