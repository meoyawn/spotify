+
+// Local read-only bridge for HTTP/3 ownership above the QUIC transport.
+// Expose genuine peer acknowledgements; do not equate queued data with ACKs.
+#[no_mangle]
+pub extern "C" fn quiche_conn_stream_acked_offset(
+    conn: &Connection, stream_id: u64, offset: *mut u64,
+) -> bool {
+    if offset.is_null() {
+        return false;
+    }
+    match conn.streams.get(stream_id) {
+        Some(stream) => {
+            unsafe { *offset = stream.send.ack_off() };
+            true
+        },
+        None => false,
     }
 }
 
