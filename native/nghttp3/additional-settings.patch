+int nghttp3_conn_set_additional_settings(nghttp3_conn *conn,
+    const uint64_t *ids, const uint64_t *values, size_t count) {
+  size_t i, j;
+  if (conn->tx.ctrl) {
+    return NGHTTP3_ERR_INVALID_STATE;
+  }
+  if (count > 8 || (count && (!ids || !values))) {
+    return NGHTTP3_ERR_INVALID_ARGUMENT;
+  }
+  for (i = 0; i < count; ++i) {
+    if (ids[i] > NGHTTP3_MAX_VARINT || values[i] > NGHTTP3_MAX_VARINT) {
+      return NGHTTP3_ERR_INVALID_ARGUMENT;
+    }
+    switch (ids[i]) {
+    case 1: case 2: case 3: case 4: case 5: case 6: case 7: case 8:
+    case 0x33: case 0x276:
+      return NGHTTP3_ERR_INVALID_ARGUMENT;
+    }
+    for (j = 0; j < i; ++j) {
+      if (ids[i] == ids[j]) {
+        return NGHTTP3_ERR_INVALID_ARGUMENT;
+      }
+    }
+  }
+  for (i = 0; i < count; ++i) {
+    conn->local.additional_settings[i] =
+        (nghttp3_settings_entry){.id = ids[i], .value = values[i]};
+  }
+  conn->local.additional_settings_count = count;
+  return 0;
+}
+
+int nghttp3_conn_set_additional_control_frame(nghttp3_conn *conn,
+    uint64_t type, const uint8_t *payload, size_t length) {
+  if (conn->tx.ctrl) {
+    return NGHTTP3_ERR_INVALID_STATE;
+  }
+  if (type > NGHTTP3_MAX_VARINT ||
+      length > sizeof(conn->local.additional_control_payload) ||
+      (length && !payload)) {
+    return NGHTTP3_ERR_INVALID_ARGUMENT;
+  }
+  switch (type) {
+  case 0: case 1: case 2: case 3: case 4: case 5: case 6: case 7:
+  case 8: case 9: case 0x0c: case 0x0d: case 0x0f0700: case 0x0f0701:
+    return NGHTTP3_ERR_INVALID_ARGUMENT;
+  }
+  if (length) {
+    memcpy(conn->local.additional_control_payload, payload, length);
+  }
+  conn->local.additional_control_frame_type = type;
+  conn->local.additional_control_payload_length = length;
+  conn->local.additional_control_frame_set = 1;
+  return 0;
+}
+
