   nghttp3_frame *fr;
@@ -2195,6 +2253,22 @@ int nghttp3_conn_bind_control_stream(nghttp3_conn *conn, int64_t stream_id) {
     .local_settings = &conn->local.settings,
   };
 
+  if (conn->local.additional_control_frame_set) {
+    rv = nghttp3_stream_frq_emplace(stream, &fr);
+    if (rv != 0) {
+      return rv;
+    }
+    /* Reuse the opaque type/vector representation and standard frame writer.
+       The copied payload remains alive with conn until transport teardown. */
+    fr->origin = (nghttp3_frame_origin){
+      .type = conn->local.additional_control_frame_type,
+      .origin_list = {
+        .base = conn->local.additional_control_payload,
+        .len = conn->local.additional_control_payload_length,
+      },
+    };
+  }
+
   if (conn->local.settings.origin_list) {
