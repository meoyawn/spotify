  "sandbox": "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))(allow network-bind (local unix-socket (subpath \"/private/var/folders/fixture/temporary/T\")))(deny file-read* (subpath \"<HOME>/Library\"))(deny file-write* (subpath \"<HOME>/Library\"))",
  "method": "Bounded shipped-CEF URLRequest bootstrap for an isolated loopback capture.\n\nNo original desktop application or profile is launched. The worker has a fresh\ncache/root, a separate outer macOS sandbox denying non-loopback networking and\nuser Library reads/writes, and an inert explicit subprocess executable. Standard\nCEF initialization is the first gate; a failure is retained as evidence rather\nthan replaced by guessed HTTP fields.\n",
  "settingsLayoutSourceSha256": "35abb1c06740b78bc67ab975ef55801644b85a0350b6c1499fd3003dfe1cdf2f",
  "limits": [
    "Fresh isolated standard CEF profile and explicit test locale; Spotify global/context producers not executed.",
    "HTTP/1.1 loopback only; localhost trust may affect automatic headers.",
    "TLS certificate validation disabled only inside the loopback worker; TLS/QUIC fingerprints excluded.",
    "HTTP peer receives CEF-produced fields; no Dart implementation supplies expected values."
  ],
