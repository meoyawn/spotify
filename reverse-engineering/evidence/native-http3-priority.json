  "sourceProof": {
    "frameEncoding": "Google http_frames.h:36 defines request-stream PRIORITY_UPDATE type 0xf0700. HttpEncoder::SerializePriorityUpdateFrame http_encoder.cc:138-160 serializes frame type/length, prioritized request-stream ID as QUIC varint, then the exact field-value bytes without a terminator.",
    "loggerMeaning": "Chromium quic_http3_logger.cc:36-41 logs prioritized_element_id and priority_field_value; OnPriorityUpdateFrameSent:275-282 emits HTTP3_PRIORITY_UPDATE_SENT on that QUIC session source.",
    "originalChronology": "Google QuicSendControlStream::WritePriorityUpdate:104-122 invokes MaybeSendSettingsFrame, serializes the priority field, calls the debug visitor, then encodes the frame and calls WriteOrBufferData on the control stream. The captured event precedes each matching transaction-send event.",
    "nghttp3ExistingApi": "Unmodified nghttp3 v1.18.0 header:3374-3397 documents nghttp3_conn_set_client_stream_priority. Pristine nghttp3_conn.c:2929-2976 asserts client role and stream-ID range; rejects non-client-bidi or missing streams; copies caller data, enqueues a PRIORITY_UPDATE containing stream ID and exact bytes on tx.ctrl, then returns 0. It does not parse/reformat the data or change local request scheduler priority fields.",
    "nghttp3OutputOrder": "Pristine nghttp3_conn.c:2297-2328 checks unblocked control-stream output before QPACK decoder/request output. This is library output-selection policy; transport packet scheduling remains separate."
  },
  "joinContract": "Transaction request source -> latest preceding HTTP_STREAM_REQUEST_BOUND_TO_QUIC_SESSION dependency -> exactly one HTTP3_PRIORITY_UPDATE_SENT on that session with prioritized_element_id equal to transaction quic_stream_id; priority field matches outgoing priority header byte-for-byte.",
  "limits": [
    "Original capture events prove exact priority field values and source/stream association, with logging/call chronology. They do not reveal the full encoded frame bytes or packet payloads.",
    "Public pinned source supplies the frame type/encoding and enqueue semantics; no original proprietary routine was executed by this extractor.",
    "Priority and request HEADERS use different QUIC streams. Logging order does not prove packet emission, receipt or cross-stream wire ordering, retransmission order or a scheduling/performance guarantee.",
    "User-Agent context is classified independently by the captured Spotify/ or Mozilla/ prefix. Native context and bounded renderer Pathfinder values are checked separately; 51 Mozilla/-shaped requests to nonallowlisted origins also use u=4, i, so u=1, i is not a universal renderer policy.",
    "No native patches, Dart production changes, tests, app/account requests or transport probes are included."
  ]
}
