  "markingPolicyStatic": {
    "entry": "http_stream_factory_job_controller.cc:1257-1303 MaybeReportBrokenAlternativeService",
    "phase": "Alternative connection/HTTP-stream creation job outcome, not HTTP response status.",
    "reportTiming": "MaybeNotifyFactoryOfCompletion lines1305-1337 waits until main, alternative and DNS-ALPN jobs are gone, then reports and resets recorded errors. The switched-to-http-stream-pool path bypasses this reporter.",
    "orderedConditions": [
      {
        "condition": "alt_job_net_error == OK and no default-network failure",
        "result": "no marking"
      },
      {
        "condition": "main_job_net_error_ != OK",
        "result": "no marking"
      },
      {
        "condition": "alt_job_net_error == ERR_DNS_NO_MATCHING_SUPPORTED_ALPN",
        "result": "no marking"
      },
      {
        "condition": "default-network failure flag and alt_job_net_error == OK",
        "result": "timed brokenness that also clears on default-network change"
      },
      {
        "condition": "alt_job_net_error == ERR_NETWORK_CHANGED or ERR_INTERNET_DISCONNECTED",
        "result": "no marking"
      },
      {
        "condition": "alt_job_net_error == ERR_NAME_NOT_RESOLVED and alternative host equals request origin host",
        "result": "no marking"
      },
      {
        "condition": "remaining recorded alternative job failure with main error OK",
        "result": "ordinary timed brokenness"
      }
    ],
    "mainSuccessNuance": "The comment requires the main job not to fail. The literal predicate is main_job_net_error_ == OK, not a separate mainSucceeded bit. ResetErrorStatusForJobs lines660-666 restores recorded errors to OK.",
    "orphaning": "OrphanUnboundJob lines1155-1212 lets alternative/DNS jobs finish after a main winner. A successful alternative on another network retains the main job to determine default-network brokenness.",
    "cancellation": "OnRequestComplete lines275-309 destroys unbound jobs without assigning a synthetic failure status. It can still run completion reporting using previously recorded errors. Cancellation is not itself evidence of alternative-service failure.",
    "errorCategoryLimit": "The reporter has no blanket permanent/temporary error taxonomy and no explicit ERR_ABORTED exception. Separate certificate/client-auth/proxy-auth handlers lines512-579 do not themselves latch the OnStreamFailed net-error fields. Native failure-to-handler classification remains a separate boundary.",
    "httpStatuses": "OnStreamReady lines330-362 returns a created stream; the reporter receives net_error codes. HTTP429 or another HTTP status must not be passed as an alternative connection error."
  },
