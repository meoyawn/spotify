    "alreadyBroken": "MarkBrokenImpl increments history before AddToBrokenListAndMap rejects an already-enqueued key. Its current expiration is not extended.",
    "ordinaryMark": "MarkBroken removes its default-network-change marker; its timed brokenness survives a network change.",
    "networkBoundMark": "MarkBrokenUntilDefaultNetworkChanges inserts a network-change marker and also schedules normal timer expiry.",
    "expiry": "Removes active broken queue/map entries but retains recent failure history; also invokes the HttpServerProperties expiration delegate.",
    "confirm": "Confirm removes timed brokenness, recent failure history and its default-network-change marker.",
